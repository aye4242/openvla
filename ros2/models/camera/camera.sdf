<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="camera">
    <static>true</static>
    <!-- BridgeData V2 风格的俯视视角：相机在桌面上方偏前，大俯角。
         位置 (0.35, -0.25, 1.15)：桌面 (0.6,0,0.745) 前上方
         rpy (0, 0.85, 0.5)：朝桌面中心，俯视 ~49°，yaw ~29°
         画面里：桌面占主体，机械臂从下方/左侧伸入，红块在中央 -->
    <pose>0.35 -0.25 1.15 0 0.85 0.5</pose>
    <link name="camera_link">
      <visual name="visual">
        <geometry>
          <box><size>0.05 0.05 0.05</size></box>
        </geometry>
        <material>
          <ambient>0 0.5 1 1</ambient>
        </material>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>image_raw:=image_raw</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
