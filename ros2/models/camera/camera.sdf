<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="camera">
    <static>true</static>
    <!-- 主人手动调试确认的最佳视角：相机在桌面右前方，侧视偏俯。
         位置 (1.181, -0.596, 1.097)：桌面 (0.6,0,0.745) 右前方上方
         rpy (0.052, 0.199, 2.427)：朝桌面中心方向
         画面里：机械臂在左侧，桌面占主体，红块在中央 -->
    <pose>1.181 -0.596082 1.09714 0.051659 0.198579 2.42719</pose>
    <link name="camera_link">
      <visual name="visual">
        <geometry>
          <box><size>0.05 0.05 0.05</size></box>
        </geometry>
        <material>
          <ambient>0 0.5 1 1</ambient>
        </material>
      </visual>
      <sensor name="camera_sensor" type="camera">
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/camera</namespace>
            <remapping>image_raw:=image_raw</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
